# Copy this file to .env to configure ResearchOS.

# Set to "anthropic" to use Claude for the Research Planner/Critic/Interpreter,
# or leave as "mock" to use the built-in deterministic provider (no API key needed).
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

DATABASE_URL=sqlite:///./researchos.db

# Comma-separated list of origins allowed to call this API (your frontend's URL in prod)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
